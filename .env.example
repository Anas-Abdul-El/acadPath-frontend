# The AcadPath backend API (its CORS_ORIGIN must allow this app's origin).
VITE_API_URL=http://localhost:3000/api

# Public reference data for the onboarding autocomplete (no keys needed).
VITE_COUNTRIES_API_URL=https://countries.dev
# Hipo's hosted API is HTTP-only: when this app is served over HTTPS, point this at a proxy
# (browsers block HTTP requests from HTTPS pages as mixed content).
VITE_UNIVERSITIES_API_URL=http://universities.hipolabs.com
