# Used by `vite build` (Vercel). These values are public: they end up in the JS bundle.
# Variables set in the Vercel dashboard take precedence over this file.

# Same-origin: vercel.json rewrites /api to the Render backend, so the refresh cookie
# stays first-party and no CORS is involved.
VITE_API_URL=/api

# WebSockets can't go through Vercel's rewrite, so the portal stream connects to Render
# directly. The backend's CORS_ORIGIN must list this app's URL (it checks the Origin).
VITE_SOCKET_URL=https://acadpath-backend.onrender.com

# Hipo's API is HTTP-only; vercel.json proxies it so the HTTPS page can call it.
VITE_UNIVERSITIES_API_URL=/universities-api
