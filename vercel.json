{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://acadpath-backend.onrender.com/api/:path*" },
    { "source": "/universities-api/:path*", "destination": "http://universities.hipolabs.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
